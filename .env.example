BOT_TOKEN=
DB_PATH=/root/botsc1forcrnexus/sc1forcrnexus.db
ADMIN_IDS=123456789,987654321

SC_REGISTRATION_PRICE_PER_DAY=25000
SC_REGISTRATION_MIN_DAYS=1
SC_UNLIMITED_PRICE=70000
TOPUP_MIN=5000
TOPUP_EXPIRE_MS=300000

LICENSE_API_HOST=127.0.0.1
LICENSE_API_PORT=8099
LICENSE_API_TOKEN=GANTI_DENGAN_TOKEN_MIGRASI_ACAK
LICENSE_PUBLIC_BASE_URL=https://installer.domainkamu.com

# Signed lease V.1FSC.5. Private key dibuat otomatis dan WAJIB ikut backup.
LICENSE_SIGNING_PRIVATE_KEY_FILE=/root/botsc1forcrnexus/.sc1forcr-license-ed25519-private.pem
LICENSE_SIGNING_PUBLIC_KEY_FILE=/root/botsc1forcrnexus/.sc1forcr-license-ed25519-public.pem
LICENSE_LEASE_TTL_SECONDS=21600
LICENSE_LEASE_GRACE_SECONDS=86400
LICENSE_REQUIRE_MACHINE_ID=1
LICENSE_ENFORCE_SOURCE_IP=1

# Tahap migrasi: biarkan 1 sampai semua VPS sukses V.1FSC.5.
# Setelah itu ubah ke 0 dan rotasi LICENSE_API_TOKEN.
LICENSE_ALLOW_LEGACY_BEARER=1

AUTO_PROVISION_DOMAIN=1
CERTBOT_EMAIL=admin@domainkamu.com
SC_INSTALLER_LOCAL_PATH=/root/botsc1forcrnexus/scripts/setup-autoscript-compat.sh
SUMMARY_API_LOCAL_PATH=/root/botsc1forcrnexus/scripts/setup-summary-api.sh
