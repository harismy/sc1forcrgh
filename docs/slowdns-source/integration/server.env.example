# Ganti dua nilai ini sesuai domain dan backend SSH SC tujuan.
TUNNEL_DOMAIN=tunnel.example.net
SSH_UPSTREAM=127.0.0.1:109

DNS_UDP_PORT=5300
DNS_MTU=1232

# Preset awal VPS kecil; sesuaikan berdasarkan beban nyata.
SLOWDNS_KCP_WINDOW=2048
# Uji CPU saja: interval 10-50 ms, ACK langsung 0/1. Default = perilaku sc-fast7.
SLOWDNS_KCP_INTERVAL=10
SLOWDNS_KCP_ACK_NODELAY=0
GOMEMLIMIT=96MiB
GOGC=300

# 1 hanya jika VPS, firewall NAT IPv6, dan record AAAA sudah siap.
DNS_ENABLE_IPV6=0

# GOMAXPROCS boleh diatur oleh pemilik SC; jika dihilangkan, ikuti runtime Go.
